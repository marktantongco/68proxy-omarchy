{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "68proxy",
  "version": "1.1.0",
  "identifier": "com.68proxy.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "68proxy",
        "width": 1200,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "MIT \u00a9 6ix8ight",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "targets": [
      "deb",
      "appimage"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "resources": []
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}